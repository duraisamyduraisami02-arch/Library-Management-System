-- =====================================================
-- 9. CHECK AVAILABLE BOOKS
-- =====================================================

SELECT
    id,
    title,
    author,
    category,
    available
FROM books
WHERE available > 0;


-- =====================================================
-- 10. DASHBOARD DATA
-- =====================================================

SELECT
    (SELECT COALESCE(SUM(quantity), 0)
     FROM books) AS total_books,

    (SELECT COALESCE(SUM(available), 0)
     FROM books) AS available_books,

    (SELECT COUNT(*)
     FROM members) AS total_members,

    (
        (SELECT COALESCE(SUM(quantity), 0)
         FROM books)
        -
        (SELECT COALESCE(SUM(available), 0)
         FROM books)
    ) AS issued_books;
