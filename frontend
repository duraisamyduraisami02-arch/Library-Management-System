<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Library Management System</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f4f6f9;
            color: #333;
        }

        /* Header */
        header {
            background: #1e3a5f;
            color: white;
            padding: 20px;
            text-align: center;
        }

        header h1 {
            margin-bottom: 5px;
        }

        /* Navigation */
        nav {
            background: #ffffff;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            padding: 15px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        nav button {
            padding: 10px 18px;
            border: none;
            background: #1e3a5f;
            color: white;
            border-radius: 5px;
            cursor: pointer;
        }

        nav button:hover {
            background: #2e5d8c;
        }

        /* Main */
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 25px auto;
        }

        .section {
            display: none;
        }

        .section.active {
            display: block;
        }

        /* Dashboard */
        .dashboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .card h2 {
            color: #1e3a5f;
            font-size: 30px;
            margin-top: 10px;
        }

        /* Forms */
        .form-box {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin-top: 20px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 11px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .btn {
            padding: 10px 18px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            color: white;
            margin-right: 5px;
        }

        .btn-primary {
            background: #1e3a5f;
        }

        .btn-success {
            background: #198754;
        }

        .btn-danger {
            background: #dc3545;
        }

        .btn-warning {
            background: #ffc107;
            color: black;
        }

        .btn:hover {
            opacity: 0.85;
        }

        /* Tables */
        .table-box {
            background: white;
            padding: 20px;
            margin-top: 20px;
            border-radius: 10px;
            overflow-x: auto;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th,
        td {
            padding: 12px;
            border: 1px solid #ddd;
            text-align: center;
        }

        th {
            background: #1e3a5f;
            color: white;
        }

        tr:nth-child(even) {
            background: #f8f9fa;
        }

        /* Search */
        .search-box {
            margin-top: 20px;
        }

        .search-box input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        /* Message */
        .message {
            margin-top: 15px;
            padding: 12px;
            border-radius: 5px;
            display: none;
        }

        .success-message {
            background: #d1e7dd;
            color: #0f5132;
        }

        .error-message {
            background: #f8d7da;
            color: #842029;
        }

        /* Footer */
        footer {
            margin-top: 40px;
            background: #1e3a5f;
            color: white;
            text-align: center;
            padding: 20px;
        }

        /* Mobile */
        @media(max-width: 600px) {
            .container {
                width: 95%;
            }

            nav button {
                width: 100%;
            }

            table {
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>📚 Library Management System</h1>
    <p>Simple Frontend Library Management Application</p>
</header>

<nav>
    <button onclick="showSection('dashboard')">Dashboard</button>
    <button onclick="showSection('books')">Books</button>
    <button onclick="showSection('members')">Members</button>
    <button onclick="showSection('issue')">Issue Book</button>
    <button onclick="showSection('transactions')">Transactions</button>
</nav>

<div class="container">

    <!-- DASHBOARD -->
    <section id="dashboard" class="section active">

        <h2>Dashboard</h2>

        <div class="dashboard">

            <div class="card">
                <p>Total Books</p>
                <h2 id="totalBooks">0</h2>
            </div>

            <div class="card">
                <p>Available Books</p>
                <h2 id="availableBooks">0</h2>
            </div>

            <div class="card">
                <p>Total Members</p>
                <h2 id="totalMembers">0</h2>
            </div>

            <div class="card">
                <p>Issued Books</p>
                <h2 id="issuedBooks">0</h2>
            </div>

        </div>

    </section>


    <!-- BOOKS -->
    <section id="books" class="section">

        <h2>Book Management</h2>

        <div class="form-box">

            <h3>Add New Book</h3>

            <div class="form-group">
                <label>Book Title</label>
                <input type="text" id="bookTitle" placeholder="Enter book title">
            </div>

            <div class="form-group">
                <label>Author</label>
                <input type="text" id="bookAuthor" placeholder="Enter author name">
            </div>

            <div class="form-group">
                <label>Category</label>
                <input type="text" id="bookCategory" placeholder="Enter category">
            </div>

            <div class="form-group">
                <label>Quantity</label>
                <input type="number" id="bookQuantity" min="1" placeholder="Enter quantity">
            </div>

            <button class="btn btn-success" onclick="addBook()">
                Add Book
            </button>

            <button class="btn btn-warning" onclick="clearBookForm()">
                Clear
            </button>

            <div id="bookMessage" class="message"></div>

        </div>


        <div class="table-box">

            <h3>Book List</h3>

            <div class="search-box">
                <input
                    type="text"
                    id="bookSearch"
                    placeholder="Search by title, author or category..."
                    onkeyup="displayBooks()"
                >
            </div>

            <table>

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th>Quantity</th>
                        <th>Available</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="bookTableBody"></tbody>

            </table>

        </div>

    </section>


    <!-- MEMBERS -->
    <section id="members" class="section">

        <h2>Member Management</h2>

        <div class="form-box">

            <h3>Add New Member</h3>

            <div class="form-group">
                <label>Member Name</label>
                <input type="text" id="memberName" placeholder="Enter member name">
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" id="memberEmail" placeholder="Enter email">
            </div>

            <div class="form-group">
                <label>Phone</label>
                <input type="text" id="memberPhone" placeholder="Enter phone number">
            </div>

            <button class="btn btn-success" onclick="addMember()">
                Add Member
            </button>

            <button class="btn btn-warning" onclick="clearMemberForm()">
                Clear
            </button>

            <div id="memberMessage" class="message"></div>

        </div>


        <div class="table-box">

            <h3>Member List</h3>

            <table>

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="memberTableBody"></tbody>

            </table>

        </div>

    </section>


    <!-- ISSUE BOOK -->
    <section id="issue" class="section">

        <h2>Issue Book</h2>

        <div class="form-box">

            <div class="form-group">
                <label>Select Book</label>
                <select id="issueBookSelect">
                    <option value="">Select Book</option>
                </select>
            </div>

            <div class="form-group">
                <label>Select Member</label>
                <select id="issueMemberSelect">
                    <option value="">Select Member</option>
                </select>
            </div>

            <button class="btn btn-primary" onclick="issueBook()">
                Issue Book
            </button>

            <div id="issueMessage" class="message"></div>

        </div>

    </section>


    <!-- TRANSACTIONS -->
    <section id="transactions" class="section">

        <h2>Transaction History</h2>

        <div class="table-box">

            <table>

                <thead>
                    <tr>
                        <th>Transaction ID</th>
                        <th>Book</th>
                        <th>Member</th>
                        <th>Issue Date</th>
                        <th>Return Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="transactionTableBody"></tbody>

            </table>

        </div>

    </section>

</div>


<footer>
    <p>Library Management System © 2026</p>
</footer>


<script>

    /* =========================
       DATA STORAGE
    ========================= */

    let books = JSON.parse(localStorage.getItem("libraryBooks")) || [];

    let members = JSON.parse(localStorage.getItem("libraryMembers")) || [];

    let transactions =
        JSON.parse(localStorage.getItem("libraryTransactions")) || [];


    /* =========================
       SAVE DATA
    ========================= */

    function saveData() {

        localStorage.setItem(
            "libraryBooks",
            JSON.stringify(books)
        );

        localStorage.setItem(
            "libraryMembers",
            JSON.stringify(members)
        );

        localStorage.setItem(
            "libraryTransactions",
            JSON.stringify(transactions)
        );
    }


    /* =========================
       NAVIGATION
    ========================= */

    function showSection(sectionId) {

        document.querySelectorAll(".section")
            .forEach(section => {
                section.classList.remove("active");
            });

        document.getElementById(sectionId)
            .classList.add("active");

        updateDashboard();
        updateSelectBoxes();
    }


    /* =========================
       ADD BOOK
    ========================= */

    function addBook() {

        const title =
            document.getElementById("bookTitle").value.trim();

        const author =
            document.getElementById("bookAuthor").value.trim();

        const category =
            document.getElementById("bookCategory").value.trim();

        const quantity =
            parseInt(document.getElementById("bookQuantity").value);


        if (!title || !author || !category || !quantity) {

            showMessage(
                "bookMessage",
                "Please fill all fields.",
                false
            );

            return;
        }


        const book = {

            id: Date.now(),

            title: title,

            author: author,

            category: category,

            quantity: quantity,

            available: quantity

        };


        books.push(book);

        saveData();

        displayBooks();

        updateDashboard();

        updateSelectBoxes();

        clearBookForm();


        showMessage(
            "bookMessage",
            "Book added successfully!",
            true
        );
    }


    /* =========================
       CLEAR BOOK FORM
    ========================= */

    function clearBookForm() {

        document.getElementById("bookTitle").value = "";

        document.getElementById("bookAuthor").value = "";

        document.getElementById("bookCategory").value = "";

        document.getElementById("bookQuantity").value = "";
    }


    /* =========================
       DISPLAY BOOKS
    ========================= */

    function displayBooks() {

        const table =
            document.getElementById("bookTableBody");

        const search =
            document.getElementById("bookSearch")
            .value
            .toLowerCase();


        table.innerHTML = "";


        const filteredBooks = books.filter(book =>

            book.title.toLowerCase().includes(search) ||

            book.author.toLowerCase().includes(search) ||

            book.category.toLowerCase().includes(search)

        );


        filteredBooks.forEach(book => {

            const row = document.createElement("tr");


            row.innerHTML = `

                <td>${book.id}</td>

                <td>${book.title}</td>

                <td>${book.author}</td>

                <td>${book.category}</td>

                <td>${book.quantity}</td>

                <td>${book.available}</td>

                <td>

                    <button
                        class="btn btn-warning"
                        onclick="editBook(${book.id})">
                        Edit
                    </button>

                    <button
                        class="btn btn-danger"
                        onclick="deleteBook(${book.id})">
                        Delete
                    </button>

                </td>

            `;


            table.appendChild(row);

        });

    }


    /* =========================
       EDIT BOOK
    ========================= */

    function editBook(id) {

        const book =
            books.find(b => b.id === id);

        if (!book) return;


        const newTitle =
            prompt("Enter book title:", book.title);

        if (newTitle === null) return;


        const newAuthor =
            prompt("Enter author:", book.author);

        if (newAuthor === null) return;


        const newCategory =
            prompt("Enter category:", book.category);

        if (newCategory === null) return;


        book.title = newTitle;

        book.author = newAuthor;

        book.category = newCategory;


        saveData();

        displayBooks();

        updateSelectBoxes();

        showMessage(
            "bookMessage",
            "Book updated successfully!",
            true
        );
    }


    /* =========================
       DELETE BOOK
    ========================= */

    function deleteBook(id) {

        const activeIssue =
            transactions.some(
                t => t.bookId === id &&
                t.status === "Issued"
            );


        if (activeIssue) {

            alert(
                "This book is currently issued and cannot be deleted."
            );

            return;
        }


        if (!confirm("Delete this book?")) return;


        books =
            books.filter(book => book.id !== id);


        saveData();

        displayBooks();

        updateDashboard();

        updateSelectBoxes();
    }


    /* =========================
       ADD MEMBER
    ========================= */

    function addMember() {

        const name =
            document.getElementById("memberName")
            .value
            .trim();

        const email =
            document.getElementById("memberEmail")
            .value
            .trim();

        const phone =
            document.getElementById("memberPhone")
            .value
            .trim();


        if (!name || !email || !phone) {

            showMessage(
                "memberMessage",
                "Please fill all fields.",
                false
            );

            return;
        }


        const member = {

            id: Date.now(),

            name: name,

            email: email,

            phone: phone

        };


        members.push(member);

        saveData();

        displayMembers();

        updateDashboard();

        updateSelectBoxes();

        clearMemberForm();


        showMessage(
            "memberMessage",
            "Member added successfully!",
            true
        );
    }


    /* =========================
       CLEAR MEMBER FORM
    ========================= */

    function clearMemberForm() {

        document.getElementById("memberName").value = "";

        document.getElementById("memberEmail").value = "";

        document.getElementById("memberPhone").value = "";
    }


    /* =========================
       DISPLAY MEMBERS
    ========================= */

    function displayMembers() {

        const table =
            document.getElementById("memberTableBody");

        table.innerHTML = "";


        members.forEach(member => {

            const row =
                document.createElement("tr");


            row.innerHTML = `

                <td>${member.id}</td>

                <td>${member.name}</td>

                <td>${member.email}</td>

                <td>${member.phone}</td>

                <td>

                    <button
                        class="btn btn-danger"
                        onclick="deleteMember(${member.id})">
                        Delete
                    </button>

                </td>

            `;


            table.appendChild(row);

        });

    }


    /* =========================
       DELETE MEMBER
    ========================= */

    function deleteMember(id) {

        const activeIssue =
            transactions.some(
                t => t.memberId === id &&
                t.status === "Issued"
            );


        if (activeIssue) {

            alert(
                "This member has an issued book and cannot be deleted."
            );

            return;
        }


        if (!confirm("Delete this member?")) return;


        members =
            members.filter(
                member => member.id !== id
            );


        saveData();

        displayMembers();

        updateDashboard();

        updateSelectBoxes();
    }


    /* =========================
       UPDATE SELECT BOXES
    ========================= */

    function updateSelectBoxes() {

        const bookSelect =
            document.getElementById("issueBookSelect");

        const memberSelect =
            document.getElementById("issueMemberSelect");


        bookSelect.innerHTML =
            '<option value="">Select Book</option>';

        memberSelect.innerHTML =
            '<option value="">Select Member</option>';


        books
            .filter(book => book.available > 0)
            .forEach(book => {

                const option =
                    document.createElement("option");

                option.value = book.id;

                option.textContent =
                    `${book.title} - Available: ${book.available}`;

                bookSelect.appendChild(option);

            });


        members.forEach(member => {

            const option =
                document.createElement("option");

            option.value = member.id;

            option.textContent =
                member.name;

            memberSelect.appendChild(option);

        });

    }


    /* =========================
       ISSUE BOOK
    ========================= */

    function issueBook() {

        const bookId =
            parseInt(
                document.getElementById(
                    "issueBookSelect"
                ).value
            );


        const memberId =
            parseInt(
                document.getElementById(
                    "issueMemberSelect"
                ).value
            );


        if (!bookId || !memberId) {

            showMessage(
                "issueMessage",
                "Please select a book and member.",
                false
            );

            return;
        }


        const book =
            books.find(b => b.id === bookId);


        const member =
            members.find(m => m.id === memberId);


        if (!book || !member) return;


        if (book.available <= 0) {

            showMessage(
                "issueMessage",
                "Book is not available.",
                false
            );

            return;
        }


        const alreadyIssued =
            transactions.some(

                t =>
                    t.bookId === bookId &&
                    t.memberId === memberId &&
                    t.status === "Issued"

            );


        if (alreadyIssued) {

            showMessage(
                "issueMessage",
                "This member already has this book.",
                false
            );

            return;
        }


        book.available--;


        const transaction = {

            id: Date.now(),

            bookId: bookId,

            memberId: memberId,

            issueDate:
                new Date().toLocaleString(),

            returnDate: "",

            status: "Issued"

        };


        transactions.push(transaction);

        saveData();

        updateDashboard();

        updateSelectBoxes();

        displayTransactions();


        showMessage(
            "issueMessage",
            "Book issued successfully!",
            true
        );
    }


    /* =========================
       RETURN BOOK
    ========================= */

    function returnBook(transactionId) {

        const transaction =
            transactions.find(
                t => t.id === transactionId
            );


        if (!transaction) return;


        if (transaction.status === "Returned") {

            alert("Book already returned.");

            return;
        }


        const book =
            books.find(
                b => b.id === transaction.bookId
            );


        if (book) {

            book.available++;

        }


        transaction.status = "Returned";

        transaction.returnDate =
            new Date().toLocaleString();


        saveData();

        updateDashboard();

        updateSelectBoxes();

        displayTransactions();

        displayBooks();


        alert("Book returned successfully!");
    }


    /* =========================
       DISPLAY TRANSACTIONS
    ========================= */

    function displayTransactions() {

        const table =
            document.getElementById(
                "transactionTableBody"
            );


        table.innerHTML = "";


        transactions.forEach(transaction => {

            const book =
                books.find(
                    b => b.id === transaction.bookId
                );


            const member =
                members.find(
                    m => m.id === transaction.memberId
                );


            const row =
                document.createElement("tr");


            row.innerHTML = `

                <td>${transaction.id}</td>

                <td>
                    ${book ? book.title : "Unknown"}
                </td>

                <td>
                    ${member ? member.name : "Unknown"}
                </td>

                <td>
                    ${transaction.issueDate}
                </td>

                <td>
                    ${transaction.returnDate || "-"}
                </td>

                <td>
                    ${transaction.status}
                </td>

                <td>

                    ${
                        transaction.status === "Issued"

                        ?

                        `<button
                            class="btn btn-success"
                            onclick="returnBook(${transaction.id})">
                            Return
                        </button>`

                        :

                        "Completed"
                    }

                </td>

            `;


            table.appendChild(row);

        });

    }


    /* =========================
       DASHBOARD
    ========================= */

    function updateDashboard() {

        const totalBooks =
            books.reduce(
                (total, book) =>
                    total + book.quantity,
                0
            );


        const availableBooks =
            books.reduce(
                (total, book) =>
                    total + book.available,
                0
            );


        const issuedBooks =
            totalBooks - availableBooks;


        document.getElementById(
            "totalBooks"
        ).textContent = totalBooks;


        document.getElementById(
            "availableBooks"
        ).textContent = availableBooks;


        document.getElementById(
            "totalMembers"
        ).textContent = members.length;


        document.getElementById(
            "issuedBooks"
        ).textContent = issuedBooks;

    }


    /* =========================
       MESSAGE
    ========================= */

    function showMessage(
        elementId,
        message,
        success
    ) {

        const element =
            document.getElementById(elementId);


        element.textContent = message;

        element.style.display = "block";


        if (success) {

            element.className =
                "message success-message";

        } else {

            element.className =
                "message error-message";

        }


        setTimeout(() => {

            element.style.display = "none";

        }, 3000);

    }


    /* =========================
       INITIAL LOAD
    ========================= */

    displayBooks();

    displayMembers();

    displayTransactions();

    updateDashboard();

    updateSelectBoxes();

</script>

</body>
</html>
